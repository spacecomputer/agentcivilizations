# OpenRouter free-tier key. Get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Which free model to use for classification. See https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Optional: cap daily LLM calls to stay under free tier.
DAILY_LLM_BUDGET=200
