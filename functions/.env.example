# OpenRouter free-tier key. Get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: comma-separated model chain for classification, tried in order.
# Defaults to CLASSIFIER_MODELS in packages/schema (currently-available free
# models). See https://openrouter.ai/models?max_price=0
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# Optional: cap daily LLM calls to stay under free tier.
DAILY_LLM_BUDGET=200
