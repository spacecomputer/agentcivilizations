{
  "name": "functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for Agent Civilizations.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@agent-civilizations/schema": "*",
    "@agent-civilizations/verify": "*",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "fast-xml-parser": "^4.3.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": "20"
  }
}
