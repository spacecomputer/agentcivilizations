{
  "name": "agent-civilizations",
  "version": "0.1.0",
  "private": true,
  "description": "Open, tamper-evident ledger of AI-agent-civilization events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spacecomputer/agentcivilizations.git"
  },
  "workspaces": [
    "apps/*",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @agent-civilizations/schema -w @agent-civilizations/verify && npm run build -w functions -w web",
    "lint": "npm run lint --workspaces --if-present",
    "fmt": "prettier --write .",
    "emulate": "firebase emulators:start",
    "seed": "node scripts/seed.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
